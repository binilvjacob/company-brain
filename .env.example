OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql://brain:brain@db:5432/brain
GENERATION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CONFIDENCE_THRESHOLD=0.50

# Live connectors (optional — each ships dark until its secrets exist).
# Telegram: token from @BotFather; CONNECTOR_SECRET also guards POST /sync/run.
TELEGRAM_BOT_TOKEN=
CONNECTOR_SECRET=
# Slack: from the app created via docs/slack-manifest.yml (single-workspace
# install — token comes from the dashboard, no OAuth flow).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
